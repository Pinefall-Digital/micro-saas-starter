# =============================================================================
# Environment Variables Template
# Copy this file to .env.local and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Clerk Authentication
# Get these from https://dashboard.clerk.com → Your App → API Keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk redirect URLs (customize as needed)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# -----------------------------------------------------------------------------
# Database (Neon Postgres via Prisma)
# Get this from https://console.neon.tech → Your Project → Connection Details
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# Vercel
# These are automatically set in Vercel deployments.
# For local dev, you can leave them blank or pull via `vercel env pull`.
# -----------------------------------------------------------------------------
VERCEL_URL=

# Vercel Blob Storage
# Get from https://vercel.com/dashboard → Storage → Blob → Settings
BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
